#!/usr/bin/env bash
clear
echo -e "\033[1;35m=================================================================\033[0m"
echo -e "\033[1;36m  🔒 OMARCHY OPSEC CLEANER • Metadata & Dijital İz Sanitizörü \033[0m"
echo -e "\033[1;35m=================================================================\033[0m"
echo ""
echo -e "\033[1;33mSosyal medyaya veya arşive yüklemeden önce fotoğraflardaki:\033[0m"
echo -e "  • 📍 GPS Konum & Rakım Koordinatları"
echo -e "  • 📱 Kamera/Telefon Modeli & Seri Numarası"
echo -e "  • 🕒 Tam Çekim Saati & Zaman Damgası"
echo -e "  • 💻 Düzenleyen Yazılım ve Kullanıcı Bilgisi"
echo -e "\033[1;32m...tamamen sıfırlanır ve tertemiz bir kopya üretilir.\033[0m"
echo ""

# File selection via zenity or manual path
FILE_PATH=""
if command -v zenity &>/dev/null; then
    FILE_PATH=$(zenity --file-selection --title="Temizlenecek Görseli veya Belgeyi Seçin" 2>/dev/null)
fi

if [ -z "$FILE_PATH" ]; then
    echo -n "Dosya yolunu girin (veya sürükleyip bırakın): "
    read -r FILE_PATH
    FILE_PATH=$(echo "$FILE_PATH" | tr -d "'\"")
fi

if [ -n "$FILE_PATH" ] && [ -f "$FILE_PATH" ]; then
    echo ""
    echo -e "\033[1;34m🔍 İnceleniyor: $FILE_PATH\033[0m"
    
    python3 -c "
import sys, os
from PIL import Image

filepath = '$FILE_PATH'
try:
    with Image.open(filepath) as img:
        exif = img.getexif()
        if exif:
            print('\033[1;31m⚠️ Bulunan Metadata / EXIF Verileri:\033[0m')
            for k, v in list(exif.items())[:8]:
                print(f'   • Tag {k}: {str(v)[:50]}')
        else:
            print('\033[1;32m✓ Bu dosyada belirgin EXIF etiketi bulunamadı (yine de arındırılıyor...)\033[0m')
except Exception as e:
    print('Önizleme:', e)
"
    echo ""
    echo -e "\033[1;33m⚡ Dijital izler temizleniyor...\033[0m"
    python3 /home/ozdil/.config/omarchy/plugins/opsec-cleaner/cleaner-engine "$FILE_PATH"
    
    BASE_DIR=$(dirname "$FILE_PATH")
    echo ""
    echo -e "\033[1;32m✅ Başarıyla temizlendi ve güvenli kopya oluşturuldu!\033[0m"
    echo -e "📁 Klasör: \033[0;90m$BASE_DIR\033[0m"
else
    echo -e "\033[1;31mİptal edildi veya dosya seçilmedi.\033[0m"
fi

echo ""
echo -e "\033[0;90mDevam etmek için bir tuşa basın...\033[0m"
read -n 1 -s -r
